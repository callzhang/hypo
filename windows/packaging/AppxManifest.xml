<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <!--
    Publisher must match the subject of the signing certificate exactly, or
    installation fails with an error that does not say so. It is a placeholder
    until a real certificate exists; scripts/package-msix.ps1 overrides it.
  -->
  <Identity
    Name="Hypo.ClipboardSync"
    Publisher="CN=Hypo Placeholder, O=Hypo, C=US"
    Version="1.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Hypo</DisplayName>
    <PublisherDisplayName>Hypo</PublisherDisplayName>
    <Description>Clipboard sync between Windows, macOS and Android.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!--
      19041 is the earliest build with the MSIX behaviour this relies on, and is
      below the 22H2 (19045) floor the design sets. Claiming a higher minimum
      would only refuse installs that would work.
    -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Hypo" Executable="Hypo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Hypo"
        Description="Clipboard sync between Windows, macOS and Android."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="Hypo" />
      </uap:VisualElements>

      <Extensions>
        <!--
          Start with Windows. A clipboard tool that syncs only while someone
          remembers to launch it is one people stop trusting.
        -->
        <!--
          uap5, not uap: windows.startupTask is not in the uap extension
          enumeration, and makeappx rejects the package with a schema error that
          names every category except the one you wanted.
        -->
        <uap5:Extension Category="windows.startupTask" Executable="Hypo.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="HypoStartup" Enabled="true" DisplayName="Hypo" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      A full-trust desktop application: it uses the Win32 clipboard, opens
      sockets on the local network, and writes received files to disk. Nothing
      here is grantable through the sandboxed capability set.
    -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
