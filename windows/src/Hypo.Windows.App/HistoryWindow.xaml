<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hypo.Windows.App.Shell.HistoryWindow"
        Title="Hypo — Clipboard History"
        Width="520" Height="620"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="FilterBox"
             Grid.Row="0"
             Padding="6"
             TextChanged="OnFilterChanged"
             ToolTip="Search the history" />

    <ListBox x:Name="Rows"
             Grid.Row="1"
             Margin="0,10,0,10"
             HorizontalContentAlignment="Stretch"
             MouseDoubleClick="OnUseSelected">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,6">
            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
            <TextBlock Foreground="#FF6B6B6B" FontSize="11">
              <Run Text="{Binding ContentType, Mode=OneWay}" />
              <Run Text="·" />
              <Run Text="{Binding Source, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="Hint"
               Grid.Row="1"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="#FF8A8A8A"
               Text="Nothing here yet. Copy something."
               Visibility="Collapsed" />

    <TextBlock Grid.Row="2"
               Foreground="#FF6B6B6B"
               FontSize="11"
               Text="Double-click an entry to put it back on the clipboard." />
  </Grid>
</Window>
