<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hypo.Windows.App.Shell.HistoryWindow"
        Title="Hypo — Clipboard History"
        Width="520" Height="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <TextBox x:Name="FilterBox"
               Padding="6"
               TextChanged="OnFilterChanged"
               PreviewKeyDown="OnFilterKeyDown" />
      <!-- WPF has no placeholder; an unlabelled box tells the user nothing about
           what it does, which a screenshot made plain. -->
      <TextBlock x:Name="FilterHint"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TertiaryTextBrush}"
                 IsHitTestVisible="False"
                 Text="Search your clipboard history" />
    </Grid>

    <!-- Horizontal scrolling disabled so TextTrimming has a width to trim to.
         With it enabled the list grows to fit the longest entry, the ellipsis
         never appears, and a long copy pushes a scrollbar under everything,
         which a screenshot at 200% made obvious and one at 100% did not. -->
    <ListBox x:Name="Rows"
             Grid.Row="1"
             Margin="0,10,0,10"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="OnUseSelected">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,6">
            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11">
              <Run Text="{Binding ContentType, Mode=OneWay}" />
              <Run Text="·" />
              <Run Text="{Binding Source, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="Hint"
               Grid.Row="1"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{DynamicResource TertiaryTextBrush}"
               Text="Nothing here yet. Copy something."
               Visibility="Collapsed" />

    <TextBlock Grid.Row="2"
               Foreground="{DynamicResource SecondaryTextBrush}"
               FontSize="11"
               Text="Double-click an entry to put it back on the clipboard." />
  </Grid>
</Window>
