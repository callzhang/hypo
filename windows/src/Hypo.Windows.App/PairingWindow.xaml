<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hypo.Windows.App.Shell.PairingWindow"
        Title="Hypo — Pair a Device"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SecondaryTextBrush}"
               Text="Devices running Hypo on this network. Open Hypo on the other device first." />

    <!-- SizeToContent above, so the window is as tall as its contents rather
         than a number that has to be guessed against whatever the title bar and
         borders come to. A fixed height put the six-digit code row, the whole
         point of the lower half, below the bottom edge, and it took a
         screenshot to notice because clicking a control that is off-screen works
         perfectly well in code.

         The list needs a floor of its own: with the window sizing to content, an
         empty list would otherwise collapse to nothing while it is still
         looking for devices, which is exactly when someone is watching it. -->
    <ListBox x:Name="Peers"
             Grid.Row="1"
             MinHeight="280"
             Margin="0,10"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,6">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Foreground="{DynamicResource SuccessBrush}" FontSize="11" Text="{Binding Status}" />
            <TextBlock Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" Text="{Binding DeviceId}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="Message"
               Grid.Row="2"
               Margin="0,0,0,10"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="3">
      <Button x:Name="PairButton"
              Padding="12,6"
              HorizontalAlignment="Right"
              Content="Pair with selected device"
              Click="OnPair" />

      <Separator Margin="0,14,0,10" />

      <TextBlock TextWrapping="Wrap"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="Not on this network? Use a six-digit code instead." />

      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <TextBox x:Name="CodeBox" Padding="6" MaxLength="6" TextChanged="OnCodeChanged" />
          <TextBlock x:Name="CodeHint"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TertiaryTextBrush}"
                     IsHitTestVisible="False"
                     Text="Six-digit code" />
        </Grid>
        <Button x:Name="UseCodeButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                Padding="12,6"
                Content="Use code"
                Click="OnUseCode" />
        <Button x:Name="ShowCodeButton"
                Grid.Column="2"
                Margin="8,0,0,0"
                Padding="12,6"
                Content="Show a code"
                Click="OnShowCode" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>
