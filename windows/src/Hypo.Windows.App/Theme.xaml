<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Deliberately sparse. The shell's job is to bind, and a stylesheet here
       would be the first thing to drift from what anyone actually sees.

       The brushes are DynamicResource everywhere and ThemeHost replaces them
       when Windows switches between light and dark; the literals here are the
       light palette, so a window rendered before ThemeHost runs still looks
       like something. Keep them in step with ThemePalette.Light, which is
       where the values are decided and tested. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF9F9F9" />
  <SolidColorBrush x:Key="TextBrush" Color="#FF1A1A1A" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF6B6B6B" />
  <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF8A8A8A" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF3A7D44" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFD0D0D0" />

  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- TextBlock does not inherit Foreground from the window, so without this
       every label stays black and the dark theme is unreadable. -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- A Button left alone keeps its light chrome, which in the dark theme is a
       pale slab with grey text on it. -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- A whole template, not a Background setter.

       Setting Background on a ComboBox does nothing visible: its default
       template paints its own chrome and ignores it, so the control stayed a
       pale slab with white text on it in the dark theme even after being
       "themed". That is the difference between this and Button, where a setter
       was enough.

       Only what the two filter drop-downs need: closed state, a popup, and the
       arrow. No editable mode, because neither of them is editable. -->
  <Style TargetType="ToggleButton" x:Key="ComboBoxToggle">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1">
            <Path x:Name="Arrow"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{DynamicResource SecondaryTextBrush}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboBoxToggle}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          Focusable="False"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}" />

            <ContentPresenter Margin="8,0,24,0"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   Focusable="False">
              <Border Background="{DynamicResource ControlBackgroundBrush}"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="1"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ItemsPresenter />
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Row" Property="Background"
                      Value="{DynamicResource ControlBorderBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Unthemed it is a near-white line, which on a dark background is louder
       than a separator has any business being. -->
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
  </Style>
</ResourceDictionary>
