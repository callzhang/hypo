<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only, and deliberately a separate project: Hypo.Core must keep
         building and testing on any machine, because that is what the
         real-device verification from a Mac depends on. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package, not <UseWindowsForms>. The framework reference drags in
         Microsoft.WindowsDesktop.App, which does not exist off Windows and would
         stop this project's tests running there at all, and they are how most
         of this gets verified. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hypo.Core\Hypo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hypo.Windows.Tests" />
  </ItemGroup>

</Project>
